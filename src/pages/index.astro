---
import { getCollection } from 'astro:content';
import ContactSection from '../components/ContactSection.astro';
import HeroAbout from '../components/HeroAbout.astro';
import LatestArticles from '../components/LatestArticles.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import ServicesSection from '../components/ServicesSection.astro';
import SiteNavigation from '../components/SiteNavigation.astro';
import TechnologiesSection from '../components/TechnologiesSection.astro';
import { projects, services, technologyGroups } from '../data/portfolio';
import { sortPostsByDate } from '../lib/blog';
import '../styles/global.css';

const latestPosts = sortPostsByDate(
	await getCollection('blog', ({ data }) => !data.draft),
).slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Full-stack developer building reliable, maintainable web applications from interface to infrastructure."
		/>
		<meta name="theme-color" content="#0B4F5C" />
		<meta property="og:title" content="Harris Maïla Salimo — Full-Stack Developer" />
		<meta
			property="og:description"
			content="Full-stack developer building reliable, maintainable web applications from interface to infrastructure."
		/>
		<meta property="og:type" content="website" />
		<title>Harris Maïla Salimo — Full-Stack Developer</title>
	</head>
	<body>
		<SiteNavigation />
		<HeroAbout />
		<main id="main-content" tabindex="-1">
			<ProjectGrid projects={projects} />
			<ServicesSection services={services} />
			<TechnologiesSection groups={technologyGroups} />
			<LatestArticles posts={latestPosts} />
		</main>
		<ContactSection />
	</body>
</html>
