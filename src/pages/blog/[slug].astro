---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { formatPostDate } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true));

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<PageLayout
  title={`${post.data.title} — Harris Maïla Salimo`}
  description={post.data.description}
  type="article"
>
  <main class="article-page" id="main-content" tabindex="-1">
    <article>
      <header class="article-header">
        <a class="back-link" href="/blog/">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m19 11-10.2.1 3.7-3.8L11 5.8 4.8 12l6.2 6.2 1.5-1.5L8.8 13H19v-2Z" />
          </svg>
          All articles
        </a>
        {post.data.draft && <p class="draft-notice">Draft preview — this article is not published.</p>}
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <div class="article-header__meta">
          <time datetime={post.data.publishedAt.toISOString()}>
            Published {formatPostDate(post.data.publishedAt)}
          </time>
          {
            post.data.updatedAt && (
              <time datetime={post.data.updatedAt.toISOString()}>
                Updated {formatPostDate(post.data.updatedAt)}
              </time>
            )
          }
          {post.data.tags.length > 0 && <span>{post.data.tags.join(' · ')}</span>}
        </div>
      </header>
      <div class="article-prose">
        <Content />
      </div>
    </article>
    <footer class="article-footer">
      <p>Continue exploring the work behind the code.</p>
      <a class="text-link" href="/">
        View the portfolio
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 11h10.2l-3.7-3.7L13 5.8l6.2 6.2-6.2 6.2-1.5-1.5 3.7-3.7H5v-2Z" />
        </svg>
      </a>
    </footer>
  </main>
</PageLayout>
