---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { sortPostsByDate } from '../../lib/blog';

const posts = sortPostsByDate(await getCollection('blog', ({ data }) => !data.draft));
---

<PageLayout
  title="Blog — Harris Maïla Salimo"
  description="Articles about full-stack engineering, software architecture, and lessons learned while building maintainable web applications."
>
  <main class="blog-index" id="main-content" tabindex="-1">
    <header class="blog-hero">
      <p>Engineering journal</p>
      <h1>Notes from<br />the work.</h1>
      <p>
        Practical writing about full-stack development, architecture, reliability, and the decisions
        behind maintainable software.
      </p>
    </header>

    <section class="blog-feed" aria-labelledby="articles-title">
      <div class="blog-feed__heading">
        <h2 id="articles-title">All articles</h2>
        <span>{posts.length === 1 ? '1 article' : `${posts.length} articles`}</span>
      </div>
      {
        posts.length > 0 ? (
          <div class="article-list">
            {posts.map((post) => <ArticleCard post={post} />)}
          </div>
        ) : (
          <div class="empty-state empty-state--blog">
            <p>No published articles yet.</p>
            <span>The first long-form engineering note is currently being drafted.</span>
            <a class="text-link" href="/">
              Return to the portfolio
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 11h10.2l-3.7-3.7L13 5.8l6.2 6.2-6.2 6.2-1.5-1.5 3.7-3.7H5v-2Z" />
              </svg>
            </a>
          </div>
        )
      }
    </section>
  </main>
</PageLayout>
