---
import type { SocialLink, SocialPlatform } from '../data/portfolio';

interface Props {
  links: SocialLink[];
  location: 'hero' | 'contact';
}

const { links, location } = Astro.props;

const iconPaths: Record<SocialPlatform, string> = {
  github:
    'M12 .3a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.1c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.82.57A12 12 0 0 0 12 .3Z',
  linkedin:
    'M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.59 0 4.26 2.37 4.26 5.45v6.29h.02ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z',
  gitlab:
    'm22.65 14.39-10.18 7.4a.8.8 0 0 1-.94 0l-10.18-7.4a.8.8 0 0 1-.29-.9l1.21-3.72 2.42-7.45a.4.4 0 0 1 .76 0l2.42 7.45h8.26l2.42-7.45a.4.4 0 0 1 .76 0l2.42 7.45 1.21 3.72a.8.8 0 0 1-.29.9Z',
};
---

<nav class:list={['social-links', `social-links--${location}`]} aria-label={`${location === 'hero' ? 'Professional' : 'Contact'} links`}>
  {
    links.map((link) => (
      <a href={link.url} target="_blank" rel="noreferrer" aria-label={link.label}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d={iconPaths[link.platform]} />
        </svg>
      </a>
    ))
  }
</nav>
