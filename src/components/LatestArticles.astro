---
import type { BlogPost } from '../lib/blog';
import ArticleCard from './ArticleCard.astro';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

<section class="latest-articles" id="blog" aria-labelledby="latest-articles-title">
  <div class="latest-articles__inner">
    <div class="latest-articles__heading">
      <div class="section-intro">
        <p>Notes from the work</p>
        <h2 id="latest-articles-title">Latest articles</h2>
      </div>
      <a class="text-link text-link--large" href="/blog/">
        View all articles
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 11h10.2l-3.7-3.7L13 5.8l6.2 6.2-6.2 6.2-1.5-1.5 3.7-3.7H5v-2Z" />
        </svg>
      </a>
    </div>
    {
      posts.length > 0 ? (
        <div class="article-list article-list--latest">
          {posts.map((post) => <ArticleCard post={post} headingLevel="h3" />)}
        </div>
      ) : (
        <div class="empty-state">
          <p>Long-form notes on engineering decisions and lessons learned are coming soon.</p>
          <span>The first article is currently being drafted.</span>
        </div>
      )
    }
  </div>
</section>
