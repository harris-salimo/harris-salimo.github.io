---
import monogram from '../assets/identity/monogram.svg?url';
import { socialLinks } from '../data/portfolio';
import SocialLinks from './SocialLinks.astro';
---

<header class="hero" id="home">
  <div class="hero__inner">
    <section class="hero__intro" aria-labelledby="hero-title">
      <p class="hero__eyebrow">Harris Maïla Salimo</p>
      <h1 id="hero-title">Full-Stack<br />Developer</h1>
      <p class="hero__statement">I build reliable web applications from interface to infrastructure.</p>
      <SocialLinks links={socialLinks} location="hero" />
    </section>

    <div class="hero__portrait-wrap" aria-hidden="true">
      <img
        class="hero__portrait"
        src={monogram}
        alt=""
        width="900"
        height="1100"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <section class="about" aria-labelledby="about-title">
      <div class="about__copy">
        <h2 id="about-title">About me</h2>
        <p>
          I’m a full-stack developer focused on building reliable, maintainable web applications from interface to infrastructure. I work across TypeScript, React, Node.js, AdonisJS, PHP, Laravel, and SQL databases, with Linux, Bash, and Python as part of my daily toolkit. I use AI-assisted development to support exploration and implementation while keeping technical decisions, review, and testing under my responsibility.
        </p>
      </div>
    </section>
  </div>
</header>
