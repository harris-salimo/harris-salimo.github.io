---
import type { Project } from '../data/portfolio';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card">
  <img class="project-card__image" src={project.image} alt="" width="1200" height="900" loading="lazy" decoding="async" />
  <div class="project-card__body">
    <div class="project-card__heading">
      <h3>{project.title}</h3>
      <a
        class="project-card__link"
        href={project.repositoryUrl}
        target="_blank"
        rel="noreferrer"
        aria-label={`View ${project.title} on ${project.repositoryHost}`}
      >
        {
          project.repositoryHost === 'GitHub' ? (
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 .3a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.1c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.82.57A12 12 0 0 0 12 .3Z" />
            </svg>
          ) : (
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m22.65 14.39-10.18 7.4a.8.8 0 0 1-.94 0l-10.18-7.4a.8.8 0 0 1-.29-.9l1.21-3.72 2.42-7.45a.4.4 0 0 1 .76 0l2.42 7.45h8.26l2.42-7.45a.4.4 0 0 1 .76 0l2.42 7.45 1.21 3.72a.8.8 0 0 1-.29.9Z" />
            </svg>
          )
        }
      </a>
    </div>
    <p>{project.description}</p>
  </div>
</article>
