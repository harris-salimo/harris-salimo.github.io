---
import NavigationControls from './react/NavigationControls';

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isBlog = pathname.startsWith('/blog');

const items = [
  { label: 'Home', href: '/#home', current: isHome },
  { label: 'Work', href: '/#work', current: false },
  { label: 'Services', href: '/#services', current: false },
  { label: 'Blog', href: '/blog/', current: isBlog },
  { label: 'Contact', href: '/#contact', current: false },
];
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-nav" id="top" data-site-nav>
  <div class="site-nav__inner">
    <a class="site-nav__brand" href="/#home" aria-label="Harris Maïla Salimo — portfolio home">
      <span aria-hidden="true">HMS</span>
      <span>Harris Maïla Salimo</span>
    </a>

    <NavigationControls items={items} client:load />
  </div>
</header>
